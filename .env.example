# Environment & Server
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (Local MongoDB or MongoDB Atlas)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=smart_waste_db

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_key_64_characters_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Machine Learning Models
MODEL_DEVICE=cuda
CLASSIFIER_MODEL_PATH=trained_models/classification/waste_classifier.pth
DETECTION_MODEL_PATH=trained_models/detection/waste_yolo.pt
MIN_DETECTION_CONFIDENCE=0.35
MIN_CLASSIFICATION_CONFIDENCE=0.40

# Recommendation Engine Configuration
LOCATION_RULE_SET=default
RECYCLING_DATA_PATH=backend/app/recommendations/recycling_data.csv

